# Copy this file to managers/config/.env and fill in your own values.
# .env is git-ignored and kept out of the Docker image; never commit it.

# Groq API key (free at https://console.groq.com/keys). Without it, or without
# GROQ_KEY_LABEL, the app still runs with the AI unavailable: entries keep the
# student's values and are sent to the AI again on the next run.
GROQ_API_KEY=

# Any short name for the key above, e.g. main. The daily token log is kept per label.
GROQ_KEY_LABEL=

# Password for the admin role (terminal and GUI). Left empty, admin login is turned off.
ADMIN_PASSWORD=
